{
  "name": "playroom-multigame",
  "version": "5.1.0",
  "private": true,
  "description": "Real-time two-player multiplayer mini-game platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
